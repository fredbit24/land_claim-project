// 1. loadListings function - add loading state and error handling
async function loadListings() {
    const zone = document.getElementById('listingZone').value.trim();
    const container = document.getElementById('listingsResults');
    container.innerHTML = '<div class="card"><p class="muted">Loading...</p></div>';
    try {
        const res = await fetch('/api/parcels/listings/' + (zone ? '?zone=' + encodeURIComponent(zone) : ''), {headers: authHeaders()});
        if (!res.ok) throw new Error('Network response was not ok');
        const data = await res.json();
        if (!data.results || !data.results.length) { container.innerHTML = '<div class="card">No listings available.</div>'; return; }
        container.innerHTML = data.results.map(parcel => `...`).join('');
    } catch (error) {
        console.error('Error loading listings:', error);
        container.innerHTML = `<div class="card"><p class="muted">Error: ${error.message}. Please try again.</p></div>`;
    }
}

